[Unit]
Description=mem-price-dashboard API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ew
WorkingDirectory=/home/ew/work/mem-price-dashboard
EnvironmentFile=/home/ew/work/mem-price-dashboard/.env
ExecStart=/home/ew/work/mem-price-dashboard/bin/api
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
